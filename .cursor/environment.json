{
  "name": "naver-chatbot",
  "user": "ubuntu",
  "install": "bash scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "web",
      "command": ". .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ]
}
